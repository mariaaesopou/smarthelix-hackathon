# Copy to .env. Every value is a local development placeholder; never commit real
# secrets. Commented-out variables have no effect yet, or are set by Compose.

# --- PostgreSQL (postgres, migrate, api, worker) ---
# Database user.
POSTGRES_USER=smarthelix
# Local-only password. An existing pgdata volume keeps its original password.
POSTGRES_PASSWORD=smarthelix_dev
# Database name.
POSTGRES_DB=smarthelix
# Connection string; Compose builds it from the values above.
# DATABASE_URL=postgres://smarthelix:smarthelix_dev@localhost:5432/smarthelix?sslmode=disable

# --- Migrations (migrate) ---
# Migrations folder inside the container; set by Compose.
# DBMATE_MIGRATIONS_DIR=/db/migrations

# --- Redis (api, worker) ---
# Queue connection; set by Compose.
# REDIS_URL=redis://localhost:6379

# --- API (api) ---
# Where /profiles reads from: database, or fixtures (apps/api/src/repositories/fixtures).
PROFILES_SOURCE=database
# Planned: port, currently fixed at 3000 in apps/api/src/server.ts.
# API_PORT=3000
# Planned: token for admin-only endpoints; no code reads it yet.
# ADMIN_TOKEN=change_me

# --- Sources (worker) ---
# Base URL of the mock sources, read by the connectors; set by Compose.
# MOCK_SOURCES_URL=http://localhost:4000

# --- Pipeline and Spark (worker) ---
# Spark driver heap for jobs spawned by the worker.
SPARK_DRIVER_MEMORY=2g
# Worker container memory cap; keep it well above SPARK_DRIVER_MEMORY.
# WORKER_MEM_LIMIT=4g
# Passed to the worker; needed once connectors run (Day 4). Changing it
# invalidates the erasure blocklist.
ERASURE_HMAC_SECRET=
