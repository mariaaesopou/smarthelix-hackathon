{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sync-run.json",
  "title": "SyncRun",
  "description": "Response of POST /sync/{source}: one import run and its progress.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "source",
    "mode",
    "status",
    "counts",
    "error_code",
    "created_at",
    "started_at",
    "finished_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "full",
        "incremental"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "etl_running",
        "etl_done",
        "resolved",
        "failed"
      ]
    },
    "counts": {
      "description": "Records fetched, inserted, updated and so on.",
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "started_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "finished_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
