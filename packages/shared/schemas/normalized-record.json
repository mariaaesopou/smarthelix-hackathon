{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "normalized-record.json",
  "title": "NormalizedRecord",
  "description": "Connector output, before resolution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "source_id",
    "original_url",
    "source_updated_at",
    "type",
    "name",
    "description",
    "sector",
    "region",
    "skills",
    "services",
    "needs",
    "languages",
    "website"
  ],
  "properties": {
    "source": {
      "type": "string"
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "original_url": {
      "type": "string",
      "format": "uri"
    },
    "source_updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "type": {
      "type": "string",
      "enum": [
        "sme",
        "young_entrepreneur",
        "freelancer"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "sector": {
      "type": [
        "string",
        "null"
      ]
    },
    "region": {
      "type": [
        "string",
        "null"
      ]
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "needs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "website": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    }
  }
}
