{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SimilarProfile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_id",
    "similar_id",
    "rank",
    "score"
  ],
  "properties": {
    "profile_id": {
      "type": "string",
      "format": "uuid"
    },
    "similar_id": {
      "type": "string",
      "format": "uuid"
    },
    "rank": {
      "type": "integer",
      "minimum": 1
    },
    "score": {
      "type": "number"
    }
  }
}
