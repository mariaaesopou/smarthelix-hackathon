{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "recommendation.json",
  "title": "Recommendation",
  "description": "One item of GET /profiles/{id}/similar or GET /profiles/{id}/partners.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "rank",
    "score",
    "matched_needs"
  ],
  "properties": {
    "profile": {
      "$ref": "profile-card.json"
    },
    "rank": {
      "type": "integer",
      "minimum": 1
    },
    "score": {
      "type": "number"
    },
    "matched_needs": {
      "description": "Needs of the requested profile that this one offers. Empty for similar profiles.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
