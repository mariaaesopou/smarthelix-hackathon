{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "profile-card.json",
  "title": "ProfileCard",
  "description": "Summary of a profile in result lists, similar profiles and partners.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "name",
    "description",
    "sector",
    "region",
    "skills",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "type": "string",
      "enum": [
        "sme",
        "young_entrepreneur",
        "freelancer"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "sector": {
      "type": [
        "string",
        "null"
      ]
    },
    "region": {
      "type": [
        "string",
        "null"
      ]
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sources": {
      "description": "Names of the sources this profile was built from.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
